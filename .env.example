# Copy to .env.local and fill in. Never commit .env.local.

# Project API settings → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project API settings → anon / publishable key (safe in the browser, RLS applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project API settings → service_role key. Server/test only — never imported from src/.
SUPABASE_SERVICE_ROLE_KEY=
# Which Repository the app runs on: supabase (default) | local
NEXT_PUBLIC_DATA_BACKEND=supabase
